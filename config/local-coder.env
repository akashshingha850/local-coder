# ── local-coder core settings ────────────────────────────────────────────────
# Sourced by bin/lc. Edit freely; every value can also be overridden by
# exporting the same name in your shell before running `lc`.

# Active model profile. See config/profiles.sh for definitions.
#   fast     Qwen3-Coder-30B-A3B FP8  (MoE, 3B active - best latency/quality mix)
#   quality  Qwen2.5-Coder-32B AWQ    (dense, strongest pure code completion)
#   max-ctx  Qwen3-Coder-30B-A3B BF16 (tensor-parallel over both GPUs, 256K ctx)
LC_PROFILE="${LC_PROFILE:-smart}"

# ── Network ports ────────────────────────────────────────────────────────────
LC_GATEWAY_PORT=4000     # LiteLLM - the single endpoint VSCode talks to
LC_CHAT_PORT=8001        # vLLM main agent/chat model
LC_FIM_PORT=8002         # vLLM fill-in-middle autocomplete model
LC_EMBED_PORT=8003       # vLLM embedding model for codebase indexing

# Bind address. 127.0.0.1 keeps everything on this machine (recommended).
# Use 0.0.0.0 only if another box on your LAN must reach it.
LC_BIND_HOST=127.0.0.1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Shared key the VSCode extensions present to the gateway. Generated on first
# `lc up` if left as the placeholder below.
LC_API_KEY="sk-local-xDtntL6RY7k0V87ucaGytfAXVXRsUu"

# ── Storage ──────────────────────────────────────────────────────────────────
# Where model weights live. Expect 25-70 GB per profile.
LC_MODEL_DIR="${LC_MODEL_DIR:-$HOME/local-coder/models}"

# ── Behaviour ────────────────────────────────────────────────────────────────
# Unload idle vLLM workers after N seconds (0 = never unload, always hot).
# Keeping them hot costs VRAM but removes the ~40s cold-start on first request.
LC_IDLE_TIMEOUT=0

# Seconds to wait for a model to finish loading before `lc up` gives up.
LC_STARTUP_TIMEOUT=600
